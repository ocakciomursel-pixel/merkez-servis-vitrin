# Merkez Yetkili Servisi — Temiz Google Ads & SEO URL Yapılandırması (Apache / LiteSpeed / cPanel)
DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Mevcut dosya veya klasör varsa doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dinamik XML Site Haritası & Kısayollar
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^yonetim/?$ yonetim-paneli/index.html [L]
  RewriteRule ^vitrin/?$ index.html [L]

  # 81 İl x 973 İlçe x 38 Marka Yerel SEO URL'leri (Örn: /mersin/yenisehir-bosch-servisi)
  RewriteRule ^([a-z0-9\-]+)/([a-z0-9\-]+)-([a-z0-9]+)-servisi/?$ marka-servisi/index.html?il=$1&ilce=$2&marka=$3 [QSA,L]

  # 81 İl + 38 Marka Birleşik URL'leri (Örn: /ankara-bosch-servisi)
  RewriteRule ^([a-z0-9]+)-(arcelik|beko|bosch|siemens|profilo|samsung|lg|vestel|eca|vaillant|viessmann|buderus|demirdokum|baymak|alarko|baykan|altus|miele|electrolux|aeg|regal|seg|sharp|hotpoint|ariston|indesit|ferroli|airfel|protherm|immergas|lambert|gaggenau|franke|teka|beretta|zanussi|westinghouse|amana)-servisi/?$ marka-servisi/index.html?il=$1&marka=$2 [QSA,L]

  # 38 Marka Google Ads Yetkili Servisi Sayfaları (Örn: /bosch-servisi, /eca-servisi, /arcelik-servisi)
  RewriteRule ^(arcelik|beko|bosch|siemens|profilo|samsung|lg|vestel|eca|vaillant|viessmann|buderus|demirdokum|baymak|alarko|baykan|altus|miele|electrolux|aeg|regal|seg|sharp|hotpoint|ariston|indesit|ferroli|airfel|protherm|immergas|lambert|gaggenau|franke|teka|beretta|zanussi|westinghouse|amana)-servisi/?$ marka-servisi/index.html?marka=$1 [QSA,L]

  # 71 Hizmet & Endüstriyel / Soğuk Hava Google Ads Sayfaları (Örn: /kombi-servisi, /soguk-hava-deposu-servisi, /cay-kazani-tamircisi)
  RewriteRule ^([a-z0-9\-]+-(?:servisi|tamircisi|bakimi|bakim|temizligi|temizleme|montaji|tamiri))/?$ marka-servisi/index.html?hizmet=$1 [QSA,L]
</IfModule>
